# Copy this file to `.env` in the project root and fill in your real values.
# `.env` is already in .gitignore — it will never be committed. Never paste real keys in chat or commit them.

# This project does NOT call the live Razorpay API — both data sources are
# synthetic (see PROGRESS.md for why). No Razorpay keys are needed.

# LLM provider for stage-3 (ambiguous match) resolution. Fill in whichever you'll use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: override default matching tolerances (safe to leave blank, code has defaults)
MATCH_AMOUNT_TOLERANCE=1.0
MATCH_DATE_WINDOW_DAYS=2
